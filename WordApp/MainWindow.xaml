<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WordApp"
        xmlns:System="clr-namespace:System;assembly=System.Runtime" x:Class="WordApp.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">

            <CheckBox x:Name="OnlyUnique" Content="Unique words"
                  IsChecked="True"
                  Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="WordLength" Width="47"
             Text="5">
                    <TextBox.DataContext>
                        <System:Int32/>
                    </TextBox.DataContext>
                </TextBox>

                <Label Content="Enter word length"
           Margin="10,0,0,0"/>
            </StackPanel>

            <Label x:Name="FileLabel"
               Content="No file chosen"
               IsEnabled="False"
               Margin="0,20,0,5"/>

            <Button Content="Choose file"
                Click="Button_Click_1"
                Width="100"
                HorizontalAlignment="Left"/>

            <ProgressBar Height="25"
                     Margin="0,20,0,0"
                     Visibility="Hidden"/>

            <StackPanel Orientation="Horizontal"
                    Margin="0,20,0,0">

                <Button x:Name="ThreadRun" Content="Run"
                    Width="101"
                    Height="56"
                    Click="Button_Click"
                    Background="#FF5BFF55"/>

                <Button x:Name="NoThreadRun" Content="No thread run"
                    Width="101"
                    Height="56"
                    Margin="10,0,0,0"
                    Click="Button_Click_3"
                    Background="#FFFD5E5E"/>
            </StackPanel>
        </StackPanel>


        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label x:Name="Runtime" Content="Runtime:"
               Grid.Row="0"/>

            <Label x:Name="Combination" Content="Combinations:"
               Grid.Row="1"/>

            <ListBox x:Name="CombinationList" Grid.Row="2"
                 Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Window>
